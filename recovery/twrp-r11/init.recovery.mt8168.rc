# SPDX-License-Identifier: Apache-2.0
on init
    start a05bd_recovery_watchdog

on fs
    # Vendor 4.14 FunctionFS AIO drops unaligned 24-byte ADB headers.
    setprop sys.usb.ffs.aio_compat true
    mkdir /config 0755 root root
    mount configfs none /config
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mkdir /config/usb_gadget/g1 0770 shell shell
    write /config/usb_gadget/g1/idVendor 0x18d1
    write /config/usb_gadget/g1/idProduct 0x4ee2
    write /config/usb_gadget/g1/bcdUSB 0x0200
    mkdir /config/usb_gadget/g1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/strings/0x409/serialnumber a05bd-ut-recovery
    write /config/usb_gadget/g1/strings/0x409/manufacturer A05BD-Port
    write /config/usb_gadget/g1/strings/0x409/product Ubuntu-Touch-Recovery
    mkdir /config/usb_gadget/g1/functions/ffs.adb
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    mkdir /config/usb_gadget/g1/configs/b.1 0770 shell shell
    mkdir /config/usb_gadget/g1/configs/b.1/strings/0x409 0770 shell shell
    write /config/usb_gadget/g1/configs/b.1/MaxPower 250
    setprop sys.usb.configfs 1
    setprop sys.usb.controller 11201000.usb
    setprop sys.usb.config adb
    write /sys/class/leds/lcd-backlight/brightness 102

service a05bd_recovery_watchdog /sbin/a05bd_recovery_watchdog
    class core
    user root
    group root
    seclabel u:r:recovery:s0
    critical


on boot
    setprop service.adb.root 1
    restart adbd
