 # ---------------------------------------------------
 # Compile Options
 # ---------------------------------------------------
+# DMA descriptors have 32-bit alignment in Device memory. GCC may merge
+# adjacent fields into an unaligned 64-bit store unless strict alignment is used.
+ifeq ($(CONFIG_ARM64),y)
+ccflags-y += -mstrict-align
+endif
